# Crisis Room — copy to .env and fill in. The .env file is git-ignored.
# Only the authenticated product area (accounts, site monitors, notifiers)
# needs any of this; the /console demo surface runs with none of it set.

# Sign the JWT session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# SQLAlchemy URL. Default is a SQLite file at the repo root.
DATABASE_URL=sqlite:///./crisis_room.db

# Browser origins allowed to call the API with session cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the authenticated frontend is served (used for links inside notifier emails).
PUBLIC_APP_URL=http://localhost:3000

# Synthetic monitor defaults.
MONITOR_POLL_INTERVAL_SECONDS=30
MONITOR_WINDOW_SIZE=10

# Built-in target service (integrations/target_service.py) that incidents can be
# executed against for a real, end-to-end recovery loop. Mounted at /api/target/*.
ENABLE_DEMO_TARGET=true
DEMO_TARGET_BASE_URL=http://localhost:8000

# Local dev tools under /api/dev/* (a controllable probe endpoint for the monitor).
ENABLE_DEVTOOLS=true

# Resend transactional email for incident resolution reports.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crisis Room <onboarding@resend.dev>
